+/// The pipeline state for `cs`, and the length of each of its `threadgroup` arguments. A function
+/// translated here knows their sizes from naga. A precompiled one doesn't, and parsing its module
+/// for them is what precompiling saves, so its pipeline is made with reflection, which says.
+fn pipeline_state(shared: &Shared, cs: &Compiled) -> Result<(Obj<dyn MTLComputePipelineState>, Vec<usize>), String> {
+    let error = |e: Retained<NSError>| e.localizedDescription().to_string();
+    if let Some(sizes) = &cs.threadgroup {
+        let state = shared.device.newComputePipelineStateWithFunction_error(&cs.function).map_err(error)?;
+        return Ok((state, sizes.iter().map(|&size| (size as usize).next_multiple_of(16)).collect()));
+    }
+    let mut reflection = None;
+    // SAFETY: the function is a compute kernel from a library Metal loaded; the reflection is
+    // written to a local.
+    let state = unsafe {
+        shared.device.newComputePipelineStateWithFunction_options_reflection_error(&cs.function, MTLPipelineOption::BindingInfo, Some(&mut reflection))
+    }.map_err(error)?;
+    let mut lengths = Vec::new();
+    let Some(reflection) = reflection else { return Ok((state, lengths)) };
+    for binding in reflection.bindings().iter() {
+        if binding.r#type() != MTLBindingType::ThreadgroupMemory { continue }
+        // SAFETY: a binding of type ThreadgroupMemory is an MTLThreadgroupBinding.
+        let size: usize = unsafe { msg_send![&*binding, threadgroupMemoryDataSize] };
+        let index = binding.index();
+        if lengths.len() <= index { lengths.resize(index + 1, 0); }
+        lengths[index] = size.next_multiple_of(16);
+    }
+    Ok((state, lengths))
 }
 
