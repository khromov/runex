+const GATHER: &str = r#"
+var<workgroup> unused: u32;
+var<workgroup> tile: array<u32, 64>;
+var<workgroup> hits: atomic<u32>;
+@group(0) @binding(0) var<storage, read_write> sums: array<u32>;
+
+@compute @workgroup_size(64)
+fn gather(@builtin(local_invocation_index) i: u32, @builtin(workgroup_id) group: vec3<u32>) {
+    tile[i] = i * (group.x + 1u);
+    atomicAdd(&hits, 1u);
+    workgroupBarrier();
+    if i == 0u {
+        var sum = 0u;
+        for (var k = 0u; k < 64u; k++) { sum += tile[k]; }
+        sums[group.x] = sum + atomicLoad(&hits) * 100000u;
+    }
+}
+
+@compute @workgroup_size(1)
+fn other() { unused = 1u; }
+"#;
+
+const TILES: u32 = 8;
+
+/// Each workgroup's sum over its `var<workgroup>` array, plus its atomic's count: memory the
+/// encoder sizes for each threadgroup argument (an unused workgroup global takes no index).
+fn gathers(device: &wgpu::Device, queue: &wgpu::Queue) -> Vec<u8> {
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor { label: Some("gather"), source: wgpu::ShaderSource::Wgsl(GATHER.into()) });
+    let pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: Some("gather"), layout: None, module: &module, entry_point: Some("gather"), compilation_options: Default::default(), cache: None,
+    });
+    let sums = buffer(device, u64::from(TILES * 4), wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC);
+    let group = device.create_bind_group(&wgpu::BindGroupDescriptor { label: None, layout: &pipeline.get_bind_group_layout(0),
+        entries: &[wgpu::BindGroupEntry { binding: 0, resource: sums.as_entire_binding() }] });
+    let out = buffer(device, u64::from(TILES * 4), wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ);
+    let mut encoder = device.create_command_encoder(&Default::default());
+    {
+        let mut pass = encoder.begin_compute_pass(&Default::default());
+        pass.set_pipeline(&pipeline);
+        pass.set_bind_group(0, &group, &[]);
+        pass.dispatch_workgroups(TILES, 1, 1);
+    }
+    encoder.copy_buffer_to_buffer(&sums, 0, &out, 0, u64::from(TILES * 4));
+    queue.submit([encoder.finish()]);
+    read(device, &out)
+}
