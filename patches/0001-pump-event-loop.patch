+impl<S: 'static> App<S> {
+    /// `try_run` for a host that owns the thread's run loop (a JavaScript runtime): opens the
+    /// app's window and returns the [`Pump`](crate::Pump) the host turns between its own tasks.
+    /// Agent-tooling arguments render headless before returning `Ok(None)`.
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn start(mut self) -> Result<Option<crate::Pump>, String> {
+        let args = match self.argv.take() {
+            Some(argv) => Args::parse_from(argv),
+            None => Args::parse(),
+        };
+        if args.headless() {
+            crate::render::discard_prewarm();
+            return crate::tooling::try_headless(self, args).map(|()| None);
+        }
+        let accessory = self.accessory;
+        let factory = Box::new(move |_: &[crate::Display]| vec![crate::windows::WindowSpec::from_app("main", self).into()]);
+        crate::window::start_windows(factory, args, accessory).map(Some)
+    }
+}
