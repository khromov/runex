diff --git a/crates/rune/src/window/pump.rs b/crates/rune/src/window/pump.rs
new file mode 100644
index 00000000..b5dd3a7a
--- /dev/null
+++ b/crates/rune/src/window/pump.rs
@@ -0,0 +1,72 @@
+//! The event loop turned by its host rather than run to the end: for an app embedded in a
+//! runtime that owns the main thread's run loop (a JavaScript engine), which calls `Pump::pump`
+//! between its own tasks. Same windows, input and frames as `App::run`.
+use std::time::Duration;
+
+use winit::event_loop::{ControlFlow, EventLoop};
+use winit::platform::pump_events::{EventLoopExtPumpEvents, PumpStatus};
+
+use super::event_loop::{build, finish};
+use super::{Factory, WakeEvent, Windows};
+use crate::tooling::Args;
+
+/// A started app whose event loop its host turns. `App::start` and `start_windows_with_args`
+/// build it; dropping it after the app exits releases what `App::run` releases on return.
+pub struct Pump {
+    event_loop: EventLoop<WakeEvent>,
+    windows: Windows,
+    exited: bool,
+    /// The last turn asked for a redraw that winit delivers on its next pass.
+    redraw: bool,
+}
+
+/// Runs `hook` on any thread whenever Rune wakes the event loop (a display-link frame, a
+/// handle's update, a live value): a pumping host turns the loop soon after. `None` clears it.
+pub fn set_pump_wake(hook: Option<std::sync::Arc<dyn Fn() + Send + Sync>>) {
+    super::pump_wake::set(hook);
+}
+
+impl Pump {
+    /// Dispatches the OS events and wakes that are pending, waiting at most `timeout` for one
+    /// (`Some(Duration::ZERO)` never blocks). False once the app has quit.
+    pub fn pump(&mut self, timeout: Option<Duration>) -> bool {
+        if self.exited { return false; }
+        let status = self.event_loop.pump_app_events(timeout, &mut self.windows);
+        // Only this turn's asks count. A redraw winit holds back (Wayland waits for the
+        // compositor's frame callback) or drops (a minimised window) draws nothing and asks for
+        // nothing, so the turn after it isn't due at once.
+        self.redraw = super::pump_wake::take_redraw_next_pass();
+        if let PumpStatus::Exit(_) = status {
+            self.exited = true;
+            finish();
+        }
+        !self.exited
+    }
+
+    /// How long until the loop next needs turning without an OS event: `Some(ZERO)` while it
+    /// animates or when the last turn asked for a redraw it couldn't deliver (a frame asking for
+    /// the next one), `Some(d)` for a timer or frame deadline, `None` until an event or wake.
+    pub fn next_wake(&self) -> Option<Duration> {
+        if self.exited { return None; }
+        if self.redraw { return Some(Duration::ZERO); }
+        match self.windows.flow {
+            ControlFlow::Poll => Some(Duration::ZERO),
+            ControlFlow::WaitUntil(at) => Some(at.saturating_duration_since(crate::time::Instant::now())),
+            ControlFlow::Wait => None,
+        }
+    }
+
+    /// Whether the app has quit.
+    pub fn exited(&self) -> bool { self.exited }
+}
+
+impl Drop for Pump {
+    fn drop(&mut self) {
+        if !self.exited { finish(); }
+    }
+}
+
+pub(crate) fn start_windows(factory: Factory, args: Args, accessory: bool) -> Result<Pump, String> {
+    let (event_loop, windows) = build(factory, args, accessory)?;
+    Ok(Pump { event_loop, windows, exited: false, redraw: false })
+}
diff --git a/crates/rune/src/window/pump_wake.rs b/crates/rune/src/window/pump_wake.rs
new file mode 100644
index 00000000..0685412d
--- /dev/null
+++ b/crates/rune/src/window/pump_wake.rs
@@ -0,0 +1,46 @@
+//! Every wake sent to the event loop also tells a host that turns the loop itself (`Pump`) that
+//! it has work: its thread may be parked in its own run loop rather than winit's. A redraw asked
+//! for too late in a pass for winit to deliver in it makes the host's next turn due at once
+//! instead (`redraw_next_pass`).
+use std::cell::Cell;
+use std::sync::{Arc, Mutex};
+
+use winit::event_loop::EventLoopProxy;
+
+use super::WakeEvent;
+
+pub(crate) type PumpWake = Arc<dyn Fn() + Send + Sync>;
+
+static HOOK: Mutex<Option<PumpWake>> = Mutex::new(None);
+
+thread_local! {
+    /// A redraw asked for since `take_redraw_next_pass` that winit delivers on its next pass.
+    static NEXT_PASS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// `request_redraw` too late in a pass for winit to deliver it in that pass: from a frame (the
+/// next frame, on Linux and Windows; macOS paces frames with its display link), from
+/// `about_to_wait`, or after a frame (`shell`). `run_app` makes that next pass at once. A pumping
+/// host makes it on its next turn, so `Pump::next_wake` makes that turn due now.
+pub(super) fn redraw_next_pass(window: &winit::window::Window) {
+    window.request_redraw();
+    NEXT_PASS.set(true);
+}
+
+/// Whether a redraw was asked for with `redraw_next_pass` since the last call.
+#[cfg(not(target_arch = "wasm32"))]
+pub(super) fn take_redraw_next_pass() -> bool {
+    NEXT_PASS.replace(false)
+}
+
+pub(super) fn set(hook: Option<PumpWake>) {
+    *HOOK.lock().unwrap_or_else(|e| e.into_inner()) = hook;
+}
+
+/// Sends `event` to the loop, then runs the pump's wake hook, if one is set.
+pub(crate) fn send_wake(proxy: &EventLoopProxy<WakeEvent>, event: WakeEvent) -> bool {
+    let sent = proxy.send_event(event).is_ok();
+    let hook = HOOK.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    if let Some(hook) = hook { hook(); }
+    sent
+}
